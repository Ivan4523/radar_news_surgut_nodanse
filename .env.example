# Скопируйте этот файл в .env и впишите свои значения. Файл .env никому не отправляйте.

# Токен бота: Telegram -> @BotFather -> /newbot (или /token для существующего)
TELEGRAM_BOT_TOKEN=123456789:replace_with_your_token

# Куда присылать находки. Свой ID покажет бот в ответ на /start.
# Несколько получателей через запятую: 111111111,222222222
TELEGRAM_CHAT_ID=123456789
